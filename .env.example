DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
CRON_SECRET=replace-with-a-random-64-character-secret
# Optional. Pyth Hermes has required a bearer token since the Aug 2026 Core
# upgrade; without it the Pyth cross-check is skipped and the reference price
# falls back to Jupiter's stockData quote. Register at https://pyth.network
JUPITER_API_KEY=
PYTH_API_KEY=
