DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
CRON_SECRET=replace-with-a-random-64-character-secret
# Optional. A free key from https://portal.jup.ag raises the Jupiter quote
# budget from 30 to 60 requests/min. Without it the keyless lite-api host is
# used and depth probing is throttled to DEPTH_SYMBOLS_PER_RUN tickers/minute.
JUPITER_API_KEY=
DEPTH_SYMBOLS_PER_RUN=4
# Optional. Pyth Hermes has required a bearer token since the Aug 2026 Core
# upgrade; without it the Pyth cross-check is skipped and the reference price
# falls back to Jupiter's stockData quote. Register at https://pyth.network
PYTH_API_KEY=
